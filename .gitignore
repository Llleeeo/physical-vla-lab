# Explicit publication allowlist. Raw data and local operations remain untracked.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/THIRD_PARTY.md
!/requirements-cpu.txt
!/src/
/src/*
!/src/capstone_vla/
/src/capstone_vla/*
!/src/capstone_vla/*.py
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/scripts/sim/
/scripts/sim/*
!/scripts/sim/*.py
!/tests/
/tests/*
!/tests/*.py
!/configs/
/configs/*
!/configs/dynamicvla_data_constraints.txt
!/configs/examples/
!/docs/
/docs/*
!/docs/project/
!/results/
/results/*
!/results/summaries/
!/.github/
__pycache__/
*.pyc
.env
.env.*
*.pem
*.key
*token*
*.hdf5
*.h5
*.mp4
*.tar
*.zip
*.safetensors
*.pt
*.pth
*.usd
*.usda
*.usdc
